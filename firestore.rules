rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Every private Atlas document lives below its Firebase Authentication UID.
    match /users/{uid} {
      allow create: if owns(uid);
      allow read, update, delete: if owns(uid);

      match /{document=**} {
        allow read, write: if owns(uid);
      }
    }

    // Deny everything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
